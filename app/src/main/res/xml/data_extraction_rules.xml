<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico di sistema e trasferimento da dispositivo a dispositivo (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="quadra.db" />
        <exclude domain="database" path="quadra.db-wal" />
        <exclude domain="database" path="quadra.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="quadra.db" />
        <exclude domain="database" path="quadra.db-wal" />
        <exclude domain="database" path="quadra.db-shm" />
    </device-transfer>
</data-extraction-rules>
