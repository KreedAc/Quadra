# Copia questo file in keystore.properties (che git ignora) e riempilo.
# Il percorso è relativo alla cartella del progetto.
#
# La chiave si crea una volta sola con:
#   keytool -genkeypair -v -keystore quadra-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias quadra
#
# Il file .jks va conservato anche fuori da questo computer: perderlo significa non
# poter più pubblicare aggiornamenti dell'app.
storeFile=quadra-upload.jks
storePassword=
keyAlias=quadra
keyPassword=
